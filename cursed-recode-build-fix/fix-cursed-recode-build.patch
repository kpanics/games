 name: Build Cursed Recode
 
+# Сборка идёт штатным путём проекта (см. Cursed-Recode-main/README.md):
+#   python tools\setup-libs.py  -> libs\ (jar игры, библиотеки Minecraft, Fabric Loader, Fabric API)
+#   build.cmd                   -> tools\aw.cmd (access widener) + javac --release 25 + jar
+#   cargo build --release       -> нативный движок (CursedRecode.exe, cursed_twin.exe, cursed_recode.dll)
+#
+# Почему именно так, а не Gradle/javac «руками»:
+#   * libs\ в git не лежит (.gitignore) - без setup-libs.py компилятор не видит ни Minecraft, ни Fabric;
+#   * build.cmd сам накладывает access widener, без него приватные поля игры не компилируются;
+#   * build.cmd вызывает javac --release 25, а fabric.mod.json требует java >= 25 - JDK 21 не подойдёт.
+
 on:
   push:
     branches: [ "main" ]
   workflow_dispatch:
 
+permissions:
+  contents: read
+
+concurrency:
+  group: build-${{ github.ref }}
+  cancel-in-progress: true
+
 jobs:
   build:
     runs-on: windows-latest
+    # все run-шаги по умолчанию выполняются в папке проекта и в cmd
