-        cd native
-        cargo build --release
-      working-directory: ./Cursed-Recode-main
-      shell: bash
+    - name: Cache Rust build
+      uses: actions/cache@v4
+      with:
+        path: |
+          Cursed-Recode-main/native/target
+          ~/.cargo/registry
+          ~/.cargo/git
+        key: ${{ runner.os }}-cargo-${{ hashFiles('Cursed-Recode-main/native/Cargo.lock') }}
+        restore-keys: |
+          ${{ runner.os }}-cargo-
 
-    - name: Setup Java
-      uses: actions/setup-java@v4
+    - name: Setup Java 25
+      uses: actions/setup-java@v5
       with:
         distribution: 'temurin'
-        java-version: '21'
+        java-version: '25'
 
-    - name: Compile Java (Manual)
