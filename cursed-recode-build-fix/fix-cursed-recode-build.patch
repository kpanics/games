+      with:
+        python-version: '3.12'
+
+    - name: Toolchain versions
       run: |
-        # Ищем все .java файлы и компилируем их
-        $files = Get-ChildItem -Path "Cursed-Recode-main/src" -Recurse -Filter *.java | ForEach-Object { $_.FullName }
-        javac -cp "Cursed-Recode-main/libs/*" -d "Cursed-Recode-main/out" $files
-      shell: pwsh
+        java -version
+        javac -version
+        python --version
+        cargo --version
+
+    - name: Fetch libraries (libs\)
+      run: python tools\setup-libs.py
 
-    - name: Package JAR
+    - name: Build Java mod (aw + javac + jar)
+      run: call build.cmd
+
+    - name: Build Rust native
+      run: cargo build --release
+      working-directory: Cursed-Recode-main/native
